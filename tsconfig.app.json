{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

  /* Bundler mode */
  "moduleResolution": "bundler",
  "allowImportingTsExtensions": true,
  "moduleDetection": "force",
  "noEmit": true,
  "jsx": "react-jsx",

  /* Linting */
  "strict": true,
  "noUnusedLocals": false,
  "noUnusedParameters": false,
  "noFallthroughCasesInSwitch": true,
  "resolveJsonModule": true
  },
  "include": ["src"],
  /*
   * Retired RSVP designers. V1 (RsvpDesignPage) and V2 are not routed and have
   * no importers — the one live export, FullPagePreview, was moved to
   * ./src/components/pages/RSVPs/FullPagePreview.tsx. They are kept on disk for
   * reference but excluded from typechecking so their pre-migration
   * contentWidth unions ("full" is retired, see utils/rsvpContentWidths.ts)
   * don't break the build. Delete them once nothing needs referring back.
   */
  "exclude": [
    "src/components/pages/RSVPs/RsvpDesignPage.tsx",
    "src/components/pages/RSVPs/RsvpDesignV2Page.tsx"
  ]
}
